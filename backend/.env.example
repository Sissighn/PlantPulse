GEMINI_API_KEY=your_api_key_here
JWT_SECRET=replace_with_at_least_32_random_bytes
FRONTEND_ORIGINS=http://localhost:5173,http://localhost
# DB_PATH=/absolute/path/to/plants.db
# GEMINI_TIMEOUT_MS=15000

# Open Plantbook. Keep these server-side only.
OPEN_PLANTBOOK_CLIENT_ID=your_client_id_here
OPEN_PLANTBOOK_CLIENT_SECRET=your_client_secret_here
# OPEN_PLANTBOOK_TIMEOUT_MS=10000
# Optional: if you want to use a pre-generated bearer token instead of OAuth.
# OPEN_PLANTBOOK_ACCESS_TOKEN=your_access_token_here
